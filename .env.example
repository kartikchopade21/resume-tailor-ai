# ---------------------------------------------------------------------------
# Pick ONE provider and set its key. Free options first.
# If TAILOR_PROVIDER is unset, whichever key is present below is used.
# ---------------------------------------------------------------------------
# TAILOR_PROVIDER=groq

# # Groq — FREE, open weights (Llama 3.3 70B). Key: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# OpenRouter — FREE on any model id ending in ":free". Key: https://openrouter.ai/keys
# TAILOR_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...

# Ollama — FULLY LOCAL, no key, no rate limits. Install: https://ollama.com/download
# Then:  ollama pull qwen2.5:14b-instruct
# TAILOR_PROVIDER=ollama
# OLLAMA_HOST_URL=http://localhost:11434/v1

# Google Gemini — free tier, closed weights. Key: https://aistudio.google.com/apikey
# TAILOR_PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# Paid options
# TAILOR_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# TAILOR_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Optional overrides (each provider has a sensible default model already)
# ---------------------------------------------------------------------------
# TAILOR_MODEL=llama-3.3-70b-versatile
TAILOR_TARGET_SCORE=90
TAILOR_MAX_ITERATIONS=5
